{
  "apiBase": "/api",
  "apiRoutePrefix": "/lf-nodes",
  "runtime": {
    "comfyUiProtocol": "http:",
    "comfyUiPort": 8188,
    "frontendProxyPort": 9188
  },
  "chat": {
    "provider": "kobold",
    "useProxy": true
  },
  "deploy": {
    "root": "./web/deploy",
    "runnerSubdir": "workflow-runner",
    "jsDir": "js"
  },
  "staticPaths": {
    "assets": "/lf-nodes/static/assets/",
    "workflowRunner": "/lf-nodes/static-workflow-runner/"
  },
  "theme": "dark",
  "promptTimeoutSeconds": 0
}
