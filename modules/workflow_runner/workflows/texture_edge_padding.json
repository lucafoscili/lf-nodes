{
  "load_image": {
    "inputs": {
      "image": "texture.png",
      "ui_widget": {}
    },
    "class_type": "LF_LoadPNG",
    "_meta": {
      "title": "1. Load the texture (stored values)"
    }
  },
  "load_mask": {
    "inputs": {
      "image": "mask.png",
      "ui_widget": {}
    },
    "class_type": "LF_LoadPNG",
    "_meta": {
      "title": "2. Load the coverage mask (stored values)"
    }
  },
  "mask_channel": {
    "inputs": {
      "image": [
        "load_mask",
        0
      ],
      "channel": "red"
    },
    "class_type": "ImageToMask",
    "_meta": {
      "title": "2b. Read the mask from red"
    }
  },
  "pad": {
    "inputs": {
      "image": [
        "load_image",
        0
      ],
      "mask": [
        "mask_channel",
        0
      ],
      "ui_widget": {}
    },
    "class_type": "LF_EdgePadding",
    "_meta": {
      "title": "3. Pad past the mask"
    }
  },
  "save": {
    "inputs": {
      "image": [
        "pad",
        0
      ],
      "filename_prefix": "LF_Nodes/EdgePadding",
      "bit_depth": [
        "load_image",
        2
      ],
      "compress_level": 4,
      "ui_widget": {}
    },
    "class_type": "LF_SavePNG",
    "_meta": {
      "title": "4. Save the padded texture (rounded, same bit depth)"
    }
  },
  "display_receipt": {
    "inputs": {
      "json_input": [
        "pad",
        1
      ],
      "ui_widget": ""
    },
    "class_type": "LF_DisplayJSON",
    "_meta": {
      "title": "Publish the padding receipt to Runner history"
    }
  }
}
