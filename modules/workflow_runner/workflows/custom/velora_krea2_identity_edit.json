{
  "unet": {
    "inputs": {"unet_name": "KR2\\darkBeast30BF16INT8_darkBeastKREA2FP8.safetensors", "weight_dtype": "default"},
    "class_type": "UNETLoader",
    "_meta": {"title": "Load Krea 2 model"}
  },
  "clip": {
    "inputs": {"clip_name": "qwen3vl_4b_bf16.safetensors", "type": "krea2"},
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load Krea 2 Qwen3-VL encoder"}
  },
  "vae": {
    "inputs": {"vae_name": "krea2RealVae_v10.safetensors"},
    "class_type": "VAELoader",
    "_meta": {"title": "Load Krea 2 VAE"}
  },
  "lora": {
    "inputs": {"lora_name": "KR2\\krea2_identity_edit_v1_2.safetensors", "strength_model": 1.0, "model": ["unet", 0]},
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "Apply Krea 2 Identity Edit v1.2"}
  },
  "scene": {
    "inputs": {"image": ""},
    "class_type": "LoadImage",
    "_meta": {"title": "Scene (reference 1)"}
  },
  "identity": {
    "inputs": {"image": ""},
    "class_type": "LoadImage",
    "_meta": {"title": "Canonical identity (reference 2)"}
  },
  "scene_latent": {
    "inputs": {"pixels": ["scene", 0], "vae": ["vae", 0]},
    "class_type": "VAEEncode",
    "_meta": {"title": "Encode scene reference"}
  },
  "identity_latent": {
    "inputs": {"pixels": ["identity", 0], "vae": ["vae", 0]},
    "class_type": "VAEEncode",
    "_meta": {"title": "Encode identity reference"}
  },
  "latent": {
    "inputs": {"width": 1024, "height": 1536, "batch_size": 1},
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Target latent"}
  },
  "patch": {
    "inputs": {
      "model": ["lora", 0],
      "source_latent": ["scene_latent", 0],
      "source_latent_b": ["identity_latent", 0],
      "ref_boost": 4.0,
      "ref_boost_a": 1.0,
      "fit_mode": "fit",
      "vae": ["vae", 0],
      "source_image": ["scene", 0],
      "source_image_b": ["identity", 0],
      "target_latent": ["latent", 0]
    },
    "class_type": "Krea2EditModelPatch",
    "_meta": {"title": "Patch scene + identity references"}
  },
  "positive": {
    "inputs": {"clip": ["clip", 0], "prompt": "", "image": ["scene", 0], "image_b": ["identity", 0], "grounding_px": 1024},
    "class_type": "Krea2EditGroundedEncode",
    "_meta": {"title": "Grounded restoration instruction"}
  },
  "negative": {
    "inputs": {"clip": ["clip", 0], "prompt": "", "image": ["scene", 0], "image_b": ["identity", 0], "grounding_px": 1024},
    "class_type": "Krea2EditGroundedEncode",
    "_meta": {"title": "Grounded unconditional"}
  },
  "sampler": {
    "inputs": {"seed": 42, "steps": 10, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0, "model": ["patch", 0], "positive": ["positive", 0], "negative": ["negative", 0], "latent_image": ["latent", 0]},
    "class_type": "KSampler",
    "_meta": {"title": "Krea 2 Identity Edit sampler"}
  },
  "decode": {
    "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]},
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode restoration"}
  },
  "save": {
    "inputs": {"filename_prefix": "velora/krea2_identity_edit/seed-42", "images": ["decode", 0]},
    "class_type": "SaveImage",
    "_meta": {"title": "Save one restoration"}
  }
}
