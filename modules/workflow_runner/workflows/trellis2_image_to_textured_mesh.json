{
  "load_image": {
    "class_type": "LoadImage",
    "inputs": {"image": "example.png"},
    "_meta": {"title": "Load the source image"}
  },
  "background_model": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {"bg_removal_name": "birefnet.safetensors"},
    "_meta": {"title": "Load the foreground extraction model"}
  },
  "remove_background": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": ["background_model", 0],
      "image": ["load_image", 0]
    },
    "_meta": {"title": "Extract the foreground"}
  },
  "preprocess": {
    "class_type": "ImageCropToMask",
    "inputs": {
      "images": ["load_image", 0],
      "masks": ["remove_background", 0],
      "width": 1024,
      "height": 1024,
      "pad_factor": 1.0,
      "grow_mask": 0,
      "background": "#000000"
    },
    "_meta": {"title": "Crop the isolated subject for native TRELLIS.2"}
  },
  "clip_vision": {
    "class_type": "CLIPVisionLoader",
    "inputs": {"clip_name": "dino_v3_vit_l.safetensors"},
    "_meta": {"title": "Load the native TRELLIS.2 image encoder"}
  },
  "conditioning": {
    "class_type": "Trellis2Conditioning",
    "inputs": {
      "clip_vision_model": ["clip_vision", 0],
      "image": ["preprocess", 0]
    },
    "_meta": {"title": "Encode the source image"}
  },
  "load_model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "trellis_2_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {"title": "Load the native TRELLIS.2 diffusion model"}
  },
  "structure_cfg": {
    "class_type": "CFGOverride",
    "inputs": {
      "model": ["load_model", 0],
      "cfg": 1.0,
      "start_percent": 0.667,
      "end_percent": 1.0
    },
    "_meta": {"title": "Match the native structure guidance schedule"}
  },
  "structure_rescale": {
    "class_type": "RescaleCFG",
    "inputs": {
      "model": ["structure_cfg", 0],
      "multiplier": 0.7
    },
    "_meta": {"title": "Rescale structure guidance"}
  },
  "structure_model": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["structure_rescale", 0],
      "shift": 5.0
    },
    "_meta": {"title": "Configure structure sampling"}
  },
  "structure_latent": {
    "class_type": "EmptyTrellis2LatentStructure",
    "inputs": {"batch_size": 1},
    "_meta": {"title": "Create the sparse-structure latent"}
  },
  "sample_structure": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["structure_model", 0],
      "seed": 42,
      "steps": 12,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "positive": ["conditioning", 0],
      "negative": ["conditioning", 1],
      "latent_image": ["structure_latent", 0],
      "denoise": 1.0
    },
    "_meta": {"title": "Sample the sparse structure"}
  },
  "shape_vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "trellis_2_shape_vae_bf16.safetensors"},
    "_meta": {"title": "Load the native shape VAE"}
  },
  "decode_structure": {
    "class_type": "VaeDecodeStructureTrellis2",
    "inputs": {
      "samples": ["sample_structure", 0],
      "vae": ["shape_vae", 0],
      "resolution": "32"
    },
    "_meta": {"title": "Decode the sparse structure"}
  },
  "shape_stage": {
    "class_type": "Trellis2ShapeStage",
    "inputs": {
      "positive": ["conditioning", 0],
      "negative": ["conditioning", 1],
      "voxel": ["decode_structure", 0]
    },
    "_meta": {"title": "Prepare the 512 shape stage"}
  },
  "shape_cfg": {
    "class_type": "CFGOverride",
    "inputs": {
      "model": ["load_model", 0],
      "cfg": 1.0,
      "start_percent": 0.769,
      "end_percent": 1.0
    },
    "_meta": {"title": "Match the native shape guidance schedule"}
  },
  "shape_model": {
    "class_type": "RescaleCFG",
    "inputs": {
      "model": ["shape_cfg", 0],
      "multiplier": 0.5
    },
    "_meta": {"title": "Rescale shape guidance"}
  },
  "sample_shape_512": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["shape_model", 0],
      "seed": 42,
      "steps": 12,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "positive": ["shape_stage", 0],
      "negative": ["shape_stage", 1],
      "latent_image": ["shape_stage", 2],
      "denoise": 1.0
    },
    "_meta": {"title": "Sample the 512 shape"}
  },
  "upsample_shape": {
    "class_type": "Trellis2UpsampleStage",
    "inputs": {
      "positive": ["shape_stage", 0],
      "negative": ["shape_stage", 1],
      "shape_latent": ["sample_shape_512", 0],
      "vae": ["shape_vae", 0],
      "target_resolution": 1024
    },
    "_meta": {"title": "Upsample the shape to 1024"}
  },
  "sample_shape": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["shape_model", 0],
      "seed": 42,
      "steps": 12,
      "cfg": 7.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["upsample_shape", 0],
      "negative": ["upsample_shape", 1],
      "latent_image": ["upsample_shape", 2],
      "denoise": 1.0
    },
    "_meta": {"title": "Sample the 1024 shape"}
  },
  "texture_stage": {
    "class_type": "Trellis2TextureStage",
    "inputs": {
      "positive": ["upsample_shape", 0],
      "negative": ["upsample_shape", 1],
      "shape_latent": ["sample_shape", 0]
    },
    "_meta": {"title": "Prepare the texture stage"}
  },
  "sample_texture": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["load_model", 0],
      "seed": 42,
      "steps": 12,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "positive": ["texture_stage", 0],
      "negative": ["texture_stage", 1],
      "latent_image": ["texture_stage", 2],
      "denoise": 1.0
    },
    "_meta": {"title": "Sample the texture"}
  },
  "decode_shape": {
    "class_type": "VaeDecodeShapeTrellis",
    "inputs": {
      "samples": ["sample_shape", 0],
      "vae": ["shape_vae", 0]
    },
    "_meta": {"title": "Decode the shape mesh"}
  },
  "texture_vae": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "trellis_2_texture_vae_bf16.safetensors"},
    "_meta": {"title": "Load the native texture VAE"}
  },
  "decode_texture": {
    "class_type": "VaeDecodeTextureTrellis",
    "inputs": {
      "samples": ["sample_texture", 0],
      "vae": ["texture_vae", 0],
      "shape_subdivides": ["decode_shape", 1]
    },
    "_meta": {"title": "Decode the PBR voxel texture"}
  },
  "remesh": {
    "class_type": "RemeshMesh",
    "inputs": {
      "mesh": ["decode_shape", 0],
      "resolution": 1024,
      "sign_mode": {
        "sign_mode": "udf",
        "qef": false,
        "drop_inverted_components": false,
        "drop_enclosed_components": false
      },
      "band": 1.0,
      "project_back": 0.0,
      "fix_poles": false,
      "smooth_iters": 0,
      "drop_small_components": 0.01,
      "precluster_max_verts": 20000000
    },
    "_meta": {"title": "Normalize the decoded topology"}
  },
  "decimate": {
    "class_type": "DecimateMesh",
    "inputs": {
      "mesh": ["remesh", 0],
      "target_face_count": 200000,
      "placement_mode": {"placement_mode": "midpoint"}
    },
    "_meta": {"title": "Reduce the presentation mesh"}
  },
  "smooth_before_unwrap": {
    "class_type": "MeshSmoothNormals",
    "inputs": {
      "mesh": ["decimate", 0],
      "crease_angle": 180.0
    },
    "_meta": {"title": "Smooth the presentation mesh"}
  },
  "unwrap": {
    "class_type": "UnwrapMesh",
    "inputs": {
      "mesh": ["smooth_before_unwrap", 0],
      "segmenter": "pec",
      "resolution": 4096,
      "padding": 1,
      "weld_distance": 0.0002
    },
    "_meta": {"title": "Build the UV atlas"}
  },
  "bake_texture": {
    "class_type": "BakeTextureFromVoxel",
    "inputs": {
      "mesh": ["unwrap", 0],
      "voxel_colors": ["decode_texture", 0],
      "texture_size": 4096,
      "reference_mesh": ["decode_shape", 0]
    },
    "_meta": {"title": "Bake the PBR texture atlas"}
  },
  "apply_texture": {
    "class_type": "ApplyTextureToMesh",
    "inputs": {
      "mesh": ["unwrap", 0],
      "base_color": ["bake_texture", 0],
      "metallic": ["bake_texture", 1],
      "roughness": ["bake_texture", 2]
    },
    "_meta": {"title": "Attach the PBR textures"}
  },
  "final_mesh": {
    "class_type": "MeshSmoothNormals",
    "inputs": {
      "mesh": ["apply_texture", 0],
      "crease_angle": 180.0
    },
    "_meta": {"title": "Finalize smooth mesh normals"}
  },
  "register_output": {
    "class_type": "SaveGLB",
    "inputs": {
      "mesh": ["final_mesh", 0],
      "filename_prefix": "LF_Nodes/TRELLIS2/ImageToTexturedMesh/seed-42-balanced"
    },
    "_meta": {"title": "Save the GLB in durable history"}
  },
  "render_preview": {
    "class_type": "RenderMesh",
    "inputs": {
      "mesh": ["final_mesh", 0],
      "mode": "auto",
      "width": 512,
      "height": 512,
      "background": "#000000"
    },
    "_meta": {"title": "Render a deterministic front preview"}
  },
  "save_preview": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["render_preview", 0],
      "filename_prefix": "LF_Nodes/TRELLIS2/ImageToTexturedMesh/seed-42-balanced-preview"
    },
    "_meta": {"title": "Save the Runner preview"}
  }
}
