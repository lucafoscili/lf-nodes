  "source_5": {
    "inputs": { "image": "" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference image 5" }
  },
  "source_6": {
    "inputs": { "image": "" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference image 6" }
  },
  "source_7": {
    "inputs": { "image": "" },
    "class_type": "LoadImage",
